{
  "uid": "ticketcore-cache",
  "title": "TicketCore 查询缓存与规则预热",
  "schemaVersion": 39,
  "version": 1,
  "description": "查询与后台预热分别观测。所有数值来自实际抓取；本看板不宣称未经对照验证的性能收益。每容器仅一个工作进程。",
  "tags": [
    "TicketCore",
    "缓存治理",
    "规则预热"
  ],
  "timezone": "browser",
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 成功响应占比（2xx）",
      "description": "成功响应仅包括 2xx；429、503 和业务 404 都保留在总请求分母中。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(ticketcore_http_requests_total{status=~\"2..\"}[$__rate_interval])) or on() (0 * sum(rate(ticketcore_http_requests_total[$__rate_interval])))) / clamp_min(sum(rate(ticketcore_http_requests_total[$__rate_interval])), 1e-9)",
          "legendFormat": "成功响应占比",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 拒绝与依赖故障（429/503）",
      "description": "单独显示拒绝请求，避免以大量拒绝造成的低延迟误判性能。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(ticketcore_http_requests_total{status=~\"429|503\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP p95（成功与拒绝分别展示）",
      "description": "成功响应按路由模板聚合，429/503 单独展示，避免混合延迟掩盖拒绝；无流量时不将缺失数据填成零。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ticketcore_http_request_seconds_bucket{status=~\"2..\"}[$__rate_interval])))",
          "legendFormat": "2xx {{route}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(ticketcore_http_request_seconds_bucket{status=~\"429|503\"}[$__rate_interval])))",
          "legendFormat": "HTTP {{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "缓存总命中率与负命中率（请求）",
      "description": "总命中包括 hit 和 negative_hit；分母仅初次 hit、negative_hit、miss，锁竞争后不重复计数；后台预热不混入请求命中统计。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(ticketcore_cache_events_total{source=\"request\",event=~\"hit|negative_hit\"}[$__rate_interval])) or on() (0 * sum(rate(ticketcore_cache_events_total{source=\"request\",event=~\"hit|negative_hit|miss\"}[$__rate_interval])))) / clamp_min(sum(rate(ticketcore_cache_events_total{source=\"request\",event=~\"hit|negative_hit|miss\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "总命中率（含负命中）",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum(rate(ticketcore_cache_events_total{source=\"request\",event=\"negative_hit\"}[$__rate_interval])) or on() (0 * sum(rate(ticketcore_cache_events_total{source=\"request\",event=~\"hit|negative_hit|miss\"}[$__rate_interval])))) / clamp_min(sum(rate(ticketcore_cache_events_total{source=\"request\",event=~\"hit|negative_hit|miss\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "负命中率",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "缓存锁获取、竞争与等待超时",
      "description": "锁竞争和锁超时单独展示；与重建率和回源排队结合判断。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, event) (rate(ticketcore_cache_events_total{event=~\"lock_acquired|lock_contended|lock_timeout\"}[$__rate_interval]))",
          "legendFormat": "{{source}} · {{event}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "回源活动并发与排队",
      "description": "query 与 warmup 为独立进程内预算；API 与 Arq 分别抓取后按预算聚合。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (budget) (ticketcore_db_active)",
          "legendFormat": "执行 {{budget}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (budget) (ticketcore_db_queued)",
          "legendFormat": "排队 {{budget}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "回源准入：获准、拒绝与取消",
      "description": "accepted 表示取得名额；rejected、queue_timeout、cancelled 不表示查询成功。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (budget, result) (rate(ticketcore_db_admission_total[$__rate_interval]))",
          "legendFormat": "{{budget}} · {{result}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "回源排队等待 p95",
      "description": "包含立即获准与被拒绝请求的准入等待时间；执行耗时另行展示。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, budget) (rate(ticketcore_db_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{budget}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "回源执行 p95（按结果）",
      "description": "成功、执行异常、超时与取消分别统计。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, budget, result) (rate(ticketcore_db_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{budget}} · {{result}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Redis 操作结果与故障回源",
      "description": "查询缓存 Redis 操作与降级回源分开观察；不把库存或支付判断纳入缓存策略。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(ticketcore_cache_redis_operations_total[$__rate_interval]))",
          "legendFormat": "Redis {{result}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (source) (rate(ticketcore_cache_events_total{event=\"fallback\"}[$__rate_interval]))",
          "legendFormat": "故障回源 {{source}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "热点候选数量与采集结果",
      "description": "候选数受容量上限约束；采集异常不等同于真实零访问量。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ticketcore_hotspot_candidates{job=\"ticketcore-worker\"})",
          "legendFormat": "候选数量",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (result) (rate(ticketcore_hotspot_records_total[$__rate_interval]))",
          "legendFormat": "采集 {{result}} /秒",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "规则预热轮次结果",
      "description": "仅展示预热执行事实；是否改善性能需要最终验收时进行同预算对照实验。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(ticketcore_cache_warmup_runs_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "规则预热项目结果",
      "description": "completed 包含新鲜缓存命中及实际回填，not_found 表示活动不存在；中止原因看轮次结果，实际回填看缓存事件 fill。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(ticketcore_cache_warmup_items_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "规则预热每轮 p95",
      "description": "每轮预热耗时，包含预算内提前终止的轮次。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ticketcore_cache_warmup_seconds_bucket[$__rate_interval])))",
          "legendFormat": "预热 p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "抓取目标可用性",
      "description": "API 与 worker 应分别可抓取；每个容器仅一个工作进程，当前不支持多进程指标共享。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ticketcore-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"ticketcore-api|ticketcore-worker\"}",
          "legendFormat": "{{component}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
