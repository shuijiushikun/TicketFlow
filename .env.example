# 应用基本配置
PROJECT_NAME=TicketCore
PROJECT_VERSION=1.0.0

API_V1_STR=/api/v1
ENVIRONMENT=dev
LOG_LEVEL=INFO

# 登录与身份验证
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 业务规则与分页
DEFAULT_PAGE_LIMIT=100
TICKET_RESERVATION_TIME_SECONDS=900

# PostgreSQL 连接配置，地址和端口以实际运行环境为准
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_db_password
POSTGRES_DB=ticketcore
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Redis 连接配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=10

# 活动查询缓存；以下均有默认值，不影响库存及请求幂等记录
CACHE_DETAIL_TTL_SECONDS=86400
CACHE_DETAIL_JITTER_SECONDS=3600
CACHE_LIST_TTL_SECONDS=3600
CACHE_LIST_JITTER_SECONDS=600
CACHE_NEGATIVE_TTL_SECONDS=30
CACHE_NEGATIVE_JITTER_SECONDS=30
CACHE_REDIS_TIMEOUT_SECONDS=0.15
CACHE_CIRCUIT_COOLDOWN_SECONDS=2
CACHE_LOCK_LEASE_MS=5000
CACHE_LOCK_WAIT_SECONDS=0.3
# 每个 API 进程的数据库回源预算；多进程部署需计算总和
CACHE_DB_CONCURRENCY=4
CACHE_DB_QUEUE_SIZE=8
CACHE_DB_QUEUE_TIMEOUT_SECONDS=0.05
CACHE_DB_QUERY_TIMEOUT_SECONDS=1.5
# 每秒令牌补充速率、突发容量；客户端预算与进程总预算同时生效
EVENT_QUERY_RATE=100
EVENT_QUERY_BURST=200
EVENT_QUERY_GLOBAL_RATE=1000
EVENT_QUERY_GLOBAL_BURST=2000
EVENT_QUERY_MAX_CLIENTS=10000

# 热点统计：成功的活动详情访问；只保留短期分钟桶
HOTSPOT_BUCKET_TTL_SECONDS=900
HOTSPOT_MAX_EVENTS_PER_MINUTE=5000
HOTSPOT_CANDIDATES_PER_BUCKET=100
HOTSPOT_TOP_K=20
HOTSPOT_MIN_VIEWS=20
HOTSPOT_GROWTH_MIN_VIEWS=10
HOTSPOT_GROWTH_RATIO=2
HOTSPOT_RECORD_TIMEOUT_SECONDS=0.02
# Arq 每分钟第 10 秒执行；每轮最多 20 个热点及默认第一页
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_MAX_EVENTS=20
CACHE_WARMUP_REFRESH_SECONDS=300
CACHE_WARMUP_TIMEOUT_SECONDS=15
# 本机直接运行 worker 时按需启用；监控 Compose 叠加层自动启用
WORKER_METRICS_ENABLED=false
WORKER_METRICS_PORT=8001
# 仅启用监控 Compose 时需要，在本地填写管理员密码，不提交实际值
GRAFANA_ADMIN_PASSWORD=
